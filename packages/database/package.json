{
  "name": "@posto-barato/database",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./refresh": {
      "types": "./dist/refresh.d.ts",
      "default": "./dist/refresh.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "validate": "prisma validate",
    "migrate": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.tools src/migrate.ts",
    "migrate:status": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.tools src/migrate.ts --status",
    "doctor": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.tools src/doctor.ts",
    "seed": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.tools prisma/seed.ts",
    "reset": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.tools src/migrate.ts --reset --yes-drop-everything --dev-fixture && pnpm seed",
    "refresh": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.tools src/refresh.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "prisma": "^6.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
