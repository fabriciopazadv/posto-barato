// Schema Prisma da Fase 2 (Plataforma Posto Barato).
//
// IMPORTANTE (seções 6, 7 e 8 da especificação):
//   - Os modelos do schema `collector` NÃO são tabelas: são as VIEWS de
//     compatibilidade criadas pela migração 0003 sobre as tabelas do coletor em
//     `public.*`. São somente-leitura por construção — a view não tem regra de
//     escrita, então uma tentativa de INSERT falha no banco, não só na revisão.
//   - As tabelas sensíveis (collection_evidence, collection_errors,
//     collection_runs, observation_evidence) e os campos sensíveis
//     (raw_payload, raw_registry_payload, evidence_path, observation_fingerprint,
//     source_record_hash, internal_name, cnpj, anp_*) NÃO atravessam as views —
//     a API não tem como acessá-los nem por engano.
//   - As migrations do coletor são de responsabilidade da Fase 1. A Fase 2 nunca
//     altera as tabelas do coletor (aplicamos DDL apenas no schema `app`).
//
// TIPO DOS IDENTIFICADORES — os dois lados divergem, e é de propósito:
//
//   collector.*  `String` SEM `@db.Uuid`. Os valores TÊM formato UUID, mas a
//                coluna é `text`: o coletor os declara como
//                `String @default(uuid())`, sem `@db.Uuid`. Declarar `@db.Uuid`
//                aqui faria o Prisma comparar `uuid` com `text`, e o Postgres
//                recusa esse operador — a consulta falha em tempo de execução,
//                não de compilação. O mesmo vale para `app.demo_stations`, cuja
//                chave é um id do coletor.
//
//   app.*        UUID nativo (`@db.Uuid`) em `users`, `refresh_tokens`,
//                `subscriptions` e `billing_events`. São tabelas nossas, criadas
//                pelas migrações da Fase 2, e nada as compara com o coletor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["collector", "app"]
}

/// Fonte de dados (Fase 1). `internalName` (ex.: NOTA_MT_MARKET_RESEARCH) foi
/// removido do modelo e da view: nenhuma operação da API precisa do nome
/// interno, e o que não é declarado não vaza por uma projeção esquecida. A fonte
/// apresentada ao cliente é sempre `publicName`.
model DataSource {
  id           String             @id
  publicName   String             @map("public_name")
  sourceType   String             @map("source_type")
  active       Boolean            @default(true)
  observations PriceObservation[]

  @@map("data_sources")
  @@schema("collector")
}

/// Posto identificado pela coleta (Fase 1). Leitura pública.
/// Cadastro administrativo (cnpj, corporate_name, anp_*, registry_*) fica de
/// fora da view: identifica o estabelecimento perante órgãos, não ajuda a
/// abastecer mais barato.
model Station {
  id             String             @id
  displayName    String             @map("display_name")
  displayAddress String             @map("display_address")
  neighborhood   String?
  municipality   String
  state          String
  postalCode     String?            @map("postal_code")
  latitude       Decimal?           @db.Decimal(9, 6)
  longitude      Decimal?           @db.Decimal(9, 6)
  active         Boolean            @default(true)
  firstSeenAt    DateTime           @map("first_seen_at")
  lastSeenAt     DateTime           @map("last_seen_at")
  observations   PriceObservation[]

  @@index([municipality, state])
  @@map("stations")
  @@schema("collector")
}

/// Produto canônico (Fase 1).
model Product {
  id            String             @id
  canonicalCode String             @unique @map("canonical_code")
  canonicalName String             @map("canonical_name")
  category      String
  unit          String
  active        Boolean            @default(true)
  observations  PriceObservation[]

  @@map("products")
  @@schema("collector")
}

/// Observação de preço publicável (Fase 1).
///
/// A view por trás deste modelo já filtra `status IN ('APPROVED','EXPIRED')`:
/// observação PENDING ou REJECTED não é alcançável a partir daqui de forma
/// alguma. `rawPayload`, `evidencePath`, `observationFingerprint`,
/// `sourceRecordHash` e `collectionRunId` não são declarados nem existem na view.
model PriceObservation {
  id                  String     @id
  stationId           String     @map("station_id")
  productId           String     @map("product_id")
  dataSourceId        String     @map("data_source_id")
  priceDecimal        Decimal    @map("price_decimal") @db.Decimal(10, 3)
  currency            String     @default("BRL")
  unit                String     @default("L")
  relativeTimeText    String?    @map("relative_time_text")
  /// Hora real da observação, quando a fonte a informa. Primeira escolha da
  /// data de negócio usada para eleger a observação mais recente.
  observedAt          DateTime?  @map("observed_at")
  estimatedObservedAt DateTime?  @map("estimated_observed_at")
  estimatedTime       Boolean    @default(false) @map("estimated_time")
  collectedAt         DateTime   @map("collected_at")
  sourcePosition      Int        @map("source_position")
  confidenceScore     Decimal    @default(1) @map("confidence_score") @db.Decimal(3, 2)
  /// 'APPROVED' ou 'EXPIRED' — texto, e não enum, para a Fase 2 não depender do
  /// tipo do coletor. A view converte.
  status              String
  expiresAt           DateTime?  @map("expires_at")
  createdAt           DateTime   @map("created_at")
  station             Station    @relation(fields: [stationId], references: [id])
  product             Product    @relation(fields: [productId], references: [id])
  dataSource          DataSource @relation(fields: [dataSourceId], references: [id])

  @@index([stationId])
  @@index([productId])
  @@index([collectedAt])
  @@map("price_observations")
  @@schema("collector")
}

// ---------------------------------------------------------------------------
// Schema `app` — pertence à Fase 2.
// ---------------------------------------------------------------------------

/// Marca quais postos são dados demonstrativos (seed), para rotular
/// "Dados demonstrativos" no cliente (seção 35). is_demo nunca deve misturar-se
/// silenciosamente com dados reais em produção.
model DemoStation {
  stationId String   @id @map("station_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("demo_stations")
  @@schema("app")
}

/// Conta do cliente final. Sem multi-tenant — cada usuário é a própria conta.
/// O acesso aos recursos pagos é decidido pela `Subscription` relacionada,
/// nunca por um campo booleano na conta: o estado da assinatura tem seis
/// valores e depende do tempo (teste, carência, período pago pós-cancelamento).
model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  subscription  Subscription?

  @@map("users")
  @@schema("app")
}

/// Refresh token opaco (rotativo). Armazena apenas o hash — nunca o token cru.
/// Revogação individual (`revokedAt`) e encadeamento (`replacedById`) permitem
/// detectar reuso de token roubado (seção 14: refresh token rotativo).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid

  @@index([userId])
  @@map("refresh_tokens")
  @@schema("app")
}

enum SubscriptionPlan {
  MENSAL
  SEMESTRAL
  ANUAL

  @@schema("app")
}

enum SubscriptionStatus {
  TRIAL
  TRIAL_EXPIRADO
  AGUARDANDO_PAGAMENTO
  ATIVA
  CANCELADA
  INADIMPLENTE

  @@schema("app")
}

/// Assinatura do Premium: teste grátis seguido de ciclo mensal, semestral ou
/// anual, cobrado pelo Asaas (API de Assinaturas, forma de pagamento aberta —
/// a cada ciclo o cliente escolhe Pix, cartão ou boleto).
///
/// Os marcos do teste (`trialStartedAt`/`trialEndsAt`) são gravados no cadastro
/// e nunca reescritos: é o que garante que ninguém ganha dias grátis de novo.
/// Nenhuma cobrança existe no Asaas enquanto o teste corre — a intenção fica em
/// `planoEscolhido` e a cobrança nasce na virada.
model Subscription {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  status SubscriptionStatus @default(TRIAL)
  plano  SubscriptionPlan?

  trialStartedAt DateTime @default(now()) @map("trial_started_at")
  trialEndsAt    DateTime @map("trial_ends_at")

  planoEscolhido SubscriptionPlan? @map("plano_escolhido")
  /// Preço travado no ato da escolha: mudar a tabela não altera contrato firmado.
  valorCentavos  Int?              @map("valor_centavos")
  /// CPF/CNPJ do pagador, só dígitos, pedido junto com a escolha do plano.
  /// O Asaas exige documento para criar o cliente e o app não o coleta no
  /// cadastro; guardá-lo aqui é o que permite ao cron virar o teste em cobrança
  /// sem precisar de uma segunda visita do usuário. Uso restrito à cobrança.
  cpfCnpjPagador String?           @map("cpf_cnpj_pagador")

  primeiraCobrancaEm DateTime? @map("primeira_cobranca_em")
  proximaCobrancaEm  DateTime? @map("proxima_cobranca_em")
  ultimoPagamentoEm  DateTime? @map("ultimo_pagamento_em")
  /// Início da carência de 48h aberta pelo aviso de vencimento.
  inadimplenteDesde  DateTime? @map("inadimplente_desde")
  canceladaEm        DateTime? @map("cancelada_em")
  /// Cancelada: até quando o período já pago ainda vale.
  acessoAte          DateTime? @map("acesso_ate")

  asaasCustomerId     String?  @map("asaas_customer_id")
  asaasSubscriptionId String?  @unique @map("asaas_subscription_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([status, trialEndsAt])
  @@index([updatedAt])
  @@index([asaasCustomerId])
  @@map("subscriptions")
  @@schema("app")
}

/// Evento de cobrança já processado. Chave primária é o id do evento no Asaas:
/// como ele reentrega em caso de falha, gravar antes de agir é o que impede um
/// segundo envio de reprocessar o mesmo pagamento.
model BillingEvent {
  id           String   @id
  userId       String?  @map("user_id") @db.Uuid
  evento       String
  payload      Json
  processadoEm DateTime @default(now()) @map("processado_em")

  @@index([userId])
  @@map("billing_events")
  @@schema("app")
}
