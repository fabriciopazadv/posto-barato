{
  "name": "posto-barato",
  "version": "0.2.0",
  "private": true,
  "description": "Plataforma Posto Barato — Fase 2 (API pública de leitura + clientes)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "prisma", "@prisma/engines", "esbuild", "argon2"]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @posto-barato/api dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @posto-barato/api test:integration",
    "db:generate": "pnpm --filter @posto-barato/database generate",
    "db:migrate": "pnpm --filter @posto-barato/database migrate",
    "db:migrate:status": "pnpm --filter @posto-barato/database migrate:status",
    "db:doctor": "pnpm --filter @posto-barato/database run doctor",
    "db:setup": "pnpm --filter @posto-barato/database exec tsx src/migrate.ts --dev-fixture",
    "db:seed": "pnpm --filter @posto-barato/database seed",
    "db:refresh": "pnpm --filter @posto-barato/database refresh",
    "db:reset": "pnpm --filter @posto-barato/database reset",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "css:build": "tailwindcss -c tools/tailwind/tailwind.config.cjs -i tools/tailwind/input.css -o public/assets/css/app.css --minify",
    "css:watch": "tailwindcss -c tools/tailwind/tailwind.config.cjs -i tools/tailwind/input.css -o public/assets/css/app.css --watch",
    "site:serve": "npx --yes serve public -l 4173"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^3.4.17",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
