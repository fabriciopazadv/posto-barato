# =============================================================================
# Posto Barato — Fase 2 (variáveis de ambiente). Copie para .env e ajuste.
# NUNCA coloque credenciais reais aqui. Este arquivo é versionado.
# =============================================================================

# --- Banco de dados -----------------------------------------------------------
# Um único PostgreSQL 16 + PostGIS, com uma credencial por responsabilidade.
# Ver docs/operations/database-integration.md e a matriz de papéis em
# docs/security/data-boundaries.md.
#
# DESENVOLVIMENTO: `DATABASE_URL` sozinha cobre os três papéis — é o banco local
# do compose, com um usuário só.
DATABASE_URL=postgresql://posto_barato:posto_barato@localhost:5432/posto_barato

# PRODUÇÃO: as três abaixo são OBRIGATÓRIAS e `DATABASE_URL` é ignorada. A API
# falha no boot se faltar uma — cair numa conexão genérica em silêncio é como
# uma API pública acaba conectada com um superusuário.
#
# Leitura pública (price_reader): preços, catálogo, municípios, histórico.
# Sem INSERT/UPDATE/DELETE em lugar nenhum do banco.
# DATABASE_READONLY_URL=postgresql://price_reader:__SENHA__@host:5432/posto_barato
#
# Contas, sessões e cobrança (app_writer). Única conexão da API que escreve —
# e não enxerga o coletor nem a projeção pública de preços.
# DATABASE_APP_URL=postgresql://app_writer:__SENHA__@host:5432/posto_barato
#
# Exclusiva do comando de migração (migration_admin). NÃO vai para a API:
# um processo que atende a internet não carrega credencial capaz de alterar schema.
# DATABASE_MIGRATION_URL=postgresql://migration_admin:__SENHA__@host:5432/posto_barato
#
# Exclusiva do comando de refresh (price_refresher). Só EXECUTE na função —
# nem lê a projeção que manda atualizar.
# DATABASE_REFRESH_URL=postgresql://price_refresher:__SENHA__@host:5432/posto_barato

# Bloqueia a fixture local do coletor (`db:setup`/`db:reset`). Deixe `true` em
# qualquer ambiente que aponte para o banco real — lá as tabelas do coletor já
# existem e pertencem à Fase 1. NODE_ENV=production já bloqueia por si só.
SKIP_COLLECTOR_BOOTSTRAP=false

# Trava extra do `db:reset`, que apaga schemas locais. Nunca defina em produção.
# ALLOW_DESTRUCTIVE_RESET=false

# Banco descartável dos testes de integração (`pnpm test:integration`).
# TEST_DATABASE_URL=postgresql://posto_barato:posto_barato@localhost:5432/posto_barato_test

# --- Redis (cache — próximos incrementos) ------------------------------------
REDIS_URL=redis://localhost:6379

# --- API ----------------------------------------------------------------------
NODE_ENV=development
API_PORT=3333
API_HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# Faixas de frescor do preço (horas) — RECENT/MODERATE/OLD/EXPIRED (seção 8).
FRESHNESS_RECENT_HOURS=6
FRESHNESS_MODERATE_HOURS=24
FRESHNESS_OLD_HOURS=72

# Limites de consulta e rate limit (seções 10, 30).
MAX_PAGE_SIZE=50
MAX_RADIUS_KM=50
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Localidade padrão e modo demonstração (seção 35).
DEFAULT_MUNICIPALITY=Rondonópolis
DEFAULT_STATE=MT
DEMO_MODE=true

# --- Feature flags (seção 28/36) ---------------------------------------------
FEATURE_CHARGING_STATIONS=false

# --- Autenticação (seção 14) --------------------------------------------------
# Gere um segredo forte (>= 32 caracteres), ex.: openssl rand -base64 48
AUTH_ACCESS_SECRET=troque-por-um-segredo-forte-de-pelo-menos-32-caracteres
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# false em desenvolvimento local sem HTTPS; true em produção.
COOKIE_SECURE=true

# URL pública usada nos callbacks de checkout do Asaas.
APP_URL=http://localhost:3333

# --- Assinatura do Premium (recorrente via Asaas) -----------------------------
# Sem ASAAS_API_KEY: o fluxo roda em modo simulado (a cobrança é dada como paga,
# útil para desenvolvimento/demonstração — nada é cobrado de verdade).
# Em produção a ausência da chave é ERRO, não degradação silenciosa.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Header "asaas-access-token" esperado no webhook (docs.asaas.com/docs/mecanismo-para-validacao-de-saque-via-webhooks).
# Sem ele, qualquer um forjaria PAYMENT_CONFIRMED (assinatura de graça).
ASAAS_WEBHOOK_TOKEN=

# Preços em REAIS. Vazio usa os padrões de @posto-barato/domain
# (mensal 9,99 · semestral 49,99 · anual 89,99). Mudar aqui não altera
# contratos já firmados: o valor é travado no ato da escolha.
ASAAS_VALUE_MENSAL=
ASAAS_VALUE_SEMESTRAL=
ASAAS_VALUE_ANUAL=

# Segredo de POST /billing/cron (virada do teste + reconciliação diária).
# O agendador da plataforma envia "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# --- Placeholders para próximos incrementos (ainda não usados) ----------------
# MAP_PROVIDER=
# MAP_API_KEY=
# EMAIL_PROVIDER=
# STORAGE_PROVIDER=
# SENTRY_DSN=
